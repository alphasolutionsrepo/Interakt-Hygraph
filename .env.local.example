# Hygraph — public, published content only. Safe to expose to the browser.
NEXT_PUBLIC_HYGRAPH_CDN_ENDPOINT=https://us-east-1-shared-usea1-02.cdn.hygraph.com/v2/clpa6ccl61fwn01t7e6wvds92/master

# Hygraph — authenticated, draft-capable. Mutations go here. Server/scripts only.
HYGRAPH_CONTENT_API=https://api-us-east-1-shared-usea1-02.hygraph.com/v2/clpa6ccl61fwn01t7e6wvds92/master

# Permanent auth token with content read/write. Used by the seed script only.
# Never expose to the browser; never commit a real value.
HYGRAPH_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Unsplash access key, used only by scripts/import-images.ts
UNSPLASH_ACCESS_KEY=

# Interakt — server-to-server only, never exposed to the browser.
INTERAKT_BASE_URL=http://localhost:3000
INTERAKT_PRODUCTS_INDEX_ID=
INTERAKT_CONTENT_INDEX_ID=
INTERAKT_PRODUCTS_INGESTION_KEY=
INTERAKT_CONTENT_INGESTION_KEY=

# Interakt — browser side. Access tokens are public and read-only by design,
# but they are origin-bound: add this site to the experience's allowed origins.
NEXT_PUBLIC_INTERAKT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_INTERAKT_SEARCH_TOKEN=
NEXT_PUBLIC_INTERAKT_PRODUCTS_INDEX_ID=
NEXT_PUBLIC_INTERAKT_CONTENT_INDEX_ID=
NEXT_PUBLIC_INTERAKT_CHAT_TOKEN=

# Shared secret for the Hygraph app's re-feed button.
INTERAKT_REINDEX_SECRET=

# Public tunnel that Hygraph Studio reaches this site through.
HYGRAPH_APP_PUBLIC_URL=
