{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "cleanup-assets": "node --env-file=.env.local --import tsx scripts/cleanup-assets.ts",
    "import-images": "node --env-file=.env.local --import tsx scripts/import-images.ts",
    "refine-images": "node --env-file=.env.local --import tsx scripts/refine-images.ts",
    "interakt:sample": "node --env-file=.env.local --import tsx scripts/interakt-sample.ts",
    "interakt:ingest": "node --env-file=.env.local --import tsx scripts/interakt-ingest.ts"
  },
  "dependencies": {
    "@graphcms/rich-text-react-renderer": "^0.6.1",
    "@graphcms/rich-text-types": "^0.5.0",
    "@hygraph/app-sdk-react": "^0.0.8",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
